# =============================================================================
# TRINETRA — State Governance Intelligence & Response Platform (Haryana)
# Production Environment Configuration Template
# NOTE: Replace placeholder values with cryptographically secure credentials.
# =============================================================================

# Node & Python Environments
NODE_ENV=production
ENVIRONMENT=production

# Backend Core & Security
API_V1_STR=/api/v1
PROJECT_NAME="TRINETRA Haryana Governance Platform"
SECRET_KEY=CHANGE_THIS_TO_A_CRYPTOGRAPHICALLY_RANDOM_HEX_64_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Trusted Origins (Comma-separated)
API_CORS_ORIGINS=https://trinetra.haryana.gov.in,https://admin.trinetra.haryana.gov.in

# Database Connection (PostgreSQL with PostGIS recommended in Production)
# Example: postgresql+asyncpg://trinetra_user:STRONG_PASSWORD@db-cluster.internal:5432/trinetra_prod
DATABASE_URL=sqlite+aiosqlite:///nexus_prod.db

# Storage Service (MinIO / AWS S3)
STORAGE_TYPE=local
STORAGE_BASE_DIR=./data/storage
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=trinetra-evidence

# Redis Operational Cache & Message Broker
REDIS_URL=redis://redis:6379/0

# Optional External AI Provider (Optional — Deterministic rule fallback is active by default)
AI_PROVIDER_API_KEY=
AI_PROVIDER_ENDPOINT=
AI_MODEL_NAME=

# Haryana Integration Stubs (Set to true to enable live external callbacks)
HARYANA_SARAL_INTEGRATION_ENABLED=false
HARYANA_CM_WINDOW_INTEGRATION_ENABLED=false
HARYANA_DIAL_112_INTEGRATION_ENABLED=false

# Mapbox Access Token (For Production Geospatial Rendering)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoiZXhhbXBsZSIsImEiOiJjbGV4YW1wbGUifQ.placeholder
NEXT_PUBLIC_API_URL=https://api.trinetra.haryana.gov.in
