# ==========================================
# NEXUS ENVIRONMENT CONFIGURATION (.env.example)
# ==========================================

# Application Environment
APP_ENV=development
APP_NAME=NEXUS
LOG_LEVEL=INFO
DEBUG=true

# Backend Service
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL + PostGIS for production; SQLite fallback supported in dev)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nexus
USE_SQLITE_DEV=true
SQLITE_DB_PATH=./nexus_dev.db

# Redis (Caching, Rate Limiting & Realtime Subscriptions)
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO / S3 Compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=nexusadmin
S3_SECRET_KEY=nexussecretkey123
S3_BUCKET_EVIDENCE=nexus-evidence
S3_BUCKET_GENERATED=nexus-generated
S3_BUCKET_DEMO=nexus-demo
S3_REGION=us-east-1
S3_USE_SSL=false

# Authentication & Security
AUTH_SECRET=dev-secret-key-change-in-production-nexus-operational-key-998
AUTH_TOKEN_EXPIRE_MINUTES=1440

# Demo Configuration
DEFAULT_WORLD_ID=world-nexus-city-01
DEMO_MODE=true

# AI Provider (Optional in Phase 1; not required to start)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
